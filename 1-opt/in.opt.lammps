# ============================================================
# 任务: 结构优化
# 生成时间: 2026-08-23 01:02:54   (lmpgen)
# 生成命令: lmpgen.py from-json
# 参数: data=../NaBH.dat, elements=B/H/Na, potential=deepmd:frozen_omat24_plus.pt2, relax=iso, fix_box=False, pressure=0.0
# ============================================================

# ------------------------------------------------------------
# 初始化设置
# ------------------------------------------------------------
units          metal
boundary       p p p
atom_style     atomic
atom_modify    map yes

neighbor       2.0 bin
neigh_modify   every 1 delay 0 check yes

# ------------------------------------------------------------
# 读取结构 + 质量
# ------------------------------------------------------------
read_data      ../NaBH.dat

# 元素顺序与 data 文件中的原子类型编号一一对应 (质量自动查表)
mass           1 10.81                                 # B
mass           2 1.008                                 # H
mass           3 22.99                                 # Na
# 体系: 704 原子, 3 种类型 (B/H/Na)

# ------------------------------------------------------------
# 势函数: deepmd
# ------------------------------------------------------------
pair_style     deepmd frozen_omat24_plus.pt2
pair_coeff     * * B H Na                              # deepmd

# ------------------------------------------------------------
# 优化设置
# ------------------------------------------------------------
thermo         10
thermo_style   custom step temp pe ke etotal press vol

# 晶胞弛豫: iso 模式, 目标外压 0.0 bar, 每步体积变化上限 0.001
fix            boxrelax all box/relax iso 0.0 vmax 0.001

# 最小化: cg 法, 能量/力收敛判据 1e-12/1e-12
min_style      cg
minimize       1e-12 1e-12 100000 1000000
unfix          boxrelax

# 输出优化后结构 (供后续 MD 使用)
write_data     NaBH_opt.dat
